<?xml version="1.0" encoding="utf-8"?>
<!--
  设计令牌 —— 复刻自参照物 j477si.apk（Qwen AppHook）的 Material3 取色。

  取值来源：
    MainActivity 的 MaterialTheme(colorScheme = lightColorScheme(
        primary = #FF3B82F6, surfaceContainer = #FFF8FAFC,
        onSurface = #FF1E293B, onSurfaceVariant = #FF64748B, ... ))
    FloatingPanel 的 C_* 常量（Tailwind slate + blue 调色板）

  两组取值一一对应，这里统一收口，供 themes.xml 与 UIKit.java 共用。
  注意：卡片/面板底色不走主题属性（不同 Material 版本对 surfaceContainer
  系列支持不一），而是由 UIKit 直接取用下列常量，保证渲染结果与参照物一致。
-->
<resources>

    <!-- ==================== 浅色（默认，与参照物一致） ==================== -->
    <color name="xb_bg">#FFF8FAFC</color>
    <color name="xb_surface">#FFFFFFFF</color>
    <color name="xb_surface_border">#FFE2E8F0</color>
    <color name="xb_accent">#FF3B82F6</color>
    <color name="xb_accent_dim">#FFDBEAFE</color>
    <color name="xb_text_primary">#FF1E293B</color>
    <color name="xb_text_secondary">#FF64748B</color>
    <color name="xb_text_hint">#FF94A3B8</color>
    <color name="xb_divider">#FFE2E8F0</color>
    <color name="xb_input_bg">#FFF1F5F9</color>
    <color name="xb_input_border">#FFCBD5E1</color>

    <!-- 语义色 -->
    <color name="xb_green">#FF10B981</color>
    <color name="xb_yellow">#FFF59E0B</color>
    <color name="xb_red">#FFEF4444</color>
    <color name="xb_purple">#FF8B5CF6</color>
    <color name="xb_white">#FFFFFFFF</color>

    <!-- ==================== 深色（参照物已定义，暂未启用） ==================== -->
    <color name="xb_dark_bg">#FF0F172A</color>
    <color name="xb_dark_surface">#FF1E293B</color>
    <color name="xb_dark_accent">#FF2563EB</color>
    <color name="xb_dark_accent_dim">#FF1E3A5F</color>
    <color name="xb_dark_border">#FF334155</color>
    <color name="xb_dark_muted">#FF6B7280</color>

    <color name="xb_launcher_background">#FF1F2937</color>
</resources>
